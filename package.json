{
  "name": "oh-my-second-brain",
  "version": "0.3.0",
  "description": "Oh My Second Brain: a host-agnostic, user-owned convention layer for Obsidian and plain-markdown knowledge vaults.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "oh-my-second-brain": "dist/cli/oms.js",
    "oms": "dist/cli/oms.js",
    "oms-guard": "assets/claude/hooks/oms-guard.mjs",
    "oms-post-guard": "assets/claude/hooks/oms-post-guard.mjs"
  },
  "main": "dist/kernel/index.js",
  "types": "dist/kernel/index.d.ts",
  "files": [
    "dist",
    "core/AGENTS.md",
    "core/ontology",
    ".claude-plugin",
    ".codex-plugin",
    ".mcp.json",
    ".mcp.codex.json",
    "assets",
    "docs/adapters.md",
    "docs/install.md",
    "scripts/install.sh",
    "scripts/uninstall.sh",
    "ACKNOWLEDGMENTS.md",
    "CHANGELOG.md",
    "CHANGELOG-kernel.md",
    "CHANGELOG-cli.md",
    "CHANGELOG-mcp.md",
    "CHANGELOG-vendors.md",
    "CHANGELOG-assets.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "postbuild": "chmod +x dist/cli/oms.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:docs": "node scripts/check-doc-mapping.mjs",
    "audit": "npm audit --omit=dev",
    "release": "node scripts/release.mjs",
    "release:pack": "node scripts/release-pack.mjs",
    "release:setup-smoke": "node scripts/release-artifact-smoke.mjs --setup-only",
    "release:mcp-smoke": "node scripts/release-artifact-smoke.mjs --mcp-only",
    "release:artifact-smoke": "node scripts/release-artifact-smoke.mjs",
    "release:plugin": "node scripts/release-plugin.mjs",
    "release:check": "npm run lint && npm run build && npm test && npm run audit && npm run release:pack && npm run release:artifact-smoke && npm run release:plugin"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.10.0",
    "node-llama-cpp": "^3.18.1",
    "sqlite-vec": "^0.1.9",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoBeromsu/oh-my-second-brain.git"
  },
  "homepage": "https://github.com/GoBeromsu/oh-my-second-brain#readme",
  "bugs": {
    "url": "https://github.com/GoBeromsu/oh-my-second-brain/issues"
  },
  "keywords": [
    "obsidian",
    "knowledge-base",
    "mcp",
    "frontmatter",
    "markdown",
    "claude-code"
  ],
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "hono": "^4.12.34",
    "@hono/node-server": "^1.19.15",
    "body-parser": "^2.3.0",
    "fast-uri": "^3.1.5",
    "ip-address": "^10.3.1",
    "nanoid": "^5.1.16",
    "tar": "^7.5.21"
  }
}
