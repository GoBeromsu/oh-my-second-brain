# Dependencies & build output
# 'node_modules' (no trailing slash) so worktree symlinks are ignored too
node_modules
dist/
*.tsbuildinfo
coverage/

# Local agent-orchestration tooling state (oh-my-claudecode / oh-my-codex)
.omc/
.omx/
.omo/

# Logs & OS / editor noise
*.log
.DS_Store
.vscode/
.idea/
# Local secrets
.env
.env.*
.npmrc

# External reference repos (dev-time consultation only — see docs/dev-reference-repos.md)
vendor/reference-repos/

# oms engine cache (never committed)
.oms/cache/

# oms native semantic store — built SQLite artifact, never committed
# (.oms/ itself is committed per ADR-006; the generated store DB is not)
.oms/*.sqlite
.oms/*.sqlite-wal
.oms/*.sqlite-shm

# Private personal overlay — vault paths, names, personal recipes (R19/R20)
# .oms/ itself is committed (ADR-006); only private/ is excluded here.
private/

# QA and red-team run evidence. These are produced by a gate lane at review
# time and read from disk when the quality gate is assembled; they are outputs,
# not source, and a probe vault carrying a generated sqlite store does not
# belong in the product repository.
artifacts/

# Engine stores are generated at runtime. The markdown fixtures under
# test/fixtures/ are test INPUT and must stay tracked - ignoring the whole
# directory once removed them and broke every test that depends on the fixture.
test/fixtures/**/.oms/

# GJC agent session state (goals, ledger, plans). Local tooling scratch, not
# project content, and it is written by the GJC CLI rather than by hand.
.gjc/
